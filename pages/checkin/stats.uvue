<script setup lang="ts">
import type { CheckinStats } from '@/api/checkin.ts'

import { computed, ref } from 'vue'
import AuthLayout from '@/components/auth-layout/auth-layout.uvue'
import PageNavbar from '@/components/page-navbar/page-navbar.uvue'
import checkinApi from '@/api/checkin.ts'

const stats = ref<CheckinStats | null>(null)
const loading = ref(true)

const maxHours = computed(() => Math.max(10, ...(stats.value?.recent ?? []).map(r => r.hours)))

async function load() {
  loading.value = true
  const { isSuccess, data } = await checkinApi.stats()
  if (isSuccess && data)
    stats.value = data
  loading.value = false
}

onPageShow(() => void load())

function barHeight(hours: number) {
  return `${Math.round((hours / maxHours.value) * 100)}%`
}

</script>

<template>
  <AuthLayout>
    <view class="sp-page page">
      <PageNavbar title="考勤统计" />

      <view class="header">
        <text class="header-title">
          {{ stats?.month || '' }}考勤概览
        </text>
        <text class="header-sub">
          截止今天，数据每 5 分钟同步一次
        </text>
      </view>

      <view class="grid">
        <view class="tile">
          <text class="tile-value">
            {{ stats?.days ?? 0 }}
          </text>
          <text class="tile-label">
            出勤天数
          </text>
        </view>
        <view class="tile">
          <text class="tile-value tile-value--warn">
            {{ stats?.late ?? 0 }}
          </text>
          <text class="tile-label">
            迟到次数
          </text>
        </view>
        <view class="tile">
          <text class="tile-value">
            {{ stats?.average ?? '0.0' }}
          </text>
          <text class="tile-label">
            平均工时
          </text>
        </view>
        <view class="tile">
          <text class="tile-value tile-value--accent">
            {{ stats?.overtime ?? 0 }}
          </text>
          <text class="tile-label">
            加班时长
          </text>
        </view>
      </view>

      <view class="card">
        <view class="card-head">
          <text class="card-title">
            近 7 个工作日
          </text>
          <text class="card-hint">
            单位：小时
          </text>
        </view>

        <view v-if="loading" class="tip">
          加载中…
        </view>
        <view v-else class="chart">
          <view v-for="item in stats?.recent || []" :key="item.label" class="bar">
            <view class="bar-track">
              <view
                :class="['bar-fill', item.status === '迟到' ? 'bar-fill--warn' : '']"
                :style="{ height: barHeight(item.hours) }"
              />
            </view>
            <text class="bar-value">
              {{ item.hours }}
            </text>
            <text class="bar-label">
              {{ item.label }}
            </text>
          </view>
        </view>
      </view>

      <view class="card">
        <view class="card-head">
          <text class="card-title">
            规则说明
          </text>
        </view>
        <view class="rule">
          标准班次 09:00 - 18:00，弹性打卡 30 分钟
        </view>
        <view class="rule">
          单日工时满 8 小时计为正常出勤
        </view>
        <view class="rule rule--last">
          因公迟到可在 3 个工作日内提交补卡
        </view>
      </view>
    </view>
  </AuthLayout>
</template>

<style lang="scss">
