  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  height: 100%;
}

.bar-track {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  width: 100%;
  border-radius: 8rpx;
  background-color: #f5f6fa;
  overflow: hidden;
}

.bar-fill {
  width: 100%;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #7c6cf6 0%, #4f46e5 100%);
  transition: height 0.3s ease;
}

.bar-fill--warn {
  background: linear-gradient(180deg, #fdba74 0%, #f59e0b 100%);
}

.bar-value {
  font-size: 19rpx;
  color: #6b7080;
}

