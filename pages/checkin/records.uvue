<script setup lang="ts">
import type { CheckinRecord, CheckinStats } from '@/api/checkin.ts'
import SpEmpty from '@/components/sp-empty/sp-empty.uvue'

import { ref } from 'vue'
import AuthLayout from '@/components/auth-layout/auth-layout.uvue'
import PageNavbar from '@/components/page-navbar/page-navbar.uvue'
import checkinApi from '@/api/checkin.ts'

const list = ref<CheckinRecord[]>([])
const stats = ref<CheckinStats | null>(null)
const loading = ref(true)

async function load() {
  loading.value = true
  const [recordRes, statsRes] = await Promise.all([
    checkinApi.records({ page: 1, pagesize: 60 }),
    checkinApi.stats(),
  ])
  if (recordRes.isSuccess && recordRes.data)
    list.value = recordRes.data.list ?? []
  if (statsRes.isSuccess && statsRes.data)
    stats.value = statsRes.data
  loading.value = false
}

onPageShow(() => void load())

</script>

<template>
  <AuthLayout>
    <view class="sp-page page">
      <PageNavbar title="打卡记录" />

      <view class="summary">
        <view class="summary-item">
          <text class="summary-value">
            {{ stats?.days ?? 0 }}
          </text>
          <text class="summary-label">
            本月出勤
          </text>
        </view>
        <view class="summary-divider" />
        <view class="summary-item">
          <text class="summary-value">
            {{ stats?.average ?? '0.0' }}
          </text>
          <text class="summary-label">
            平均工时
          </text>
        </view>
        <view class="summary-divider" />
        <view class="summary-item">
          <text class="summary-value">
            {{ stats?.late ?? 0 }}
          </text>
          <text class="summary-label">
            迟到次数
          </text>
        </view>
      </view>

      <view class="card">
        <view class="card-head">
          <text class="card-title">
            每日明细
          </text>
          <text class="card-hint">
            共 {{ list.length }} 条
          </text>
        </view>

        <view v-if="loading" class="tip">
          加载中…
        </view>
        <SpEmpty v-else-if="!list.length" description="本月还没有打卡记录" />
        <template v-else>
          <view v-for="item in list" :key="item.id" class="row">
            <view class="row-date">
              <text class="row-day">
                {{ item.date }}
              </text>
              <text class="row-week">
                {{ item.weekday }}
              </text>
            </view>
            <view class="row-time">
              <text class="row-in">
                {{ item.inTime }}
              </text>
              <text class="row-arrow">
                —
              </text>
              <text class="row-out">
                {{ item.outTime }}
              </text>
            </view>
            <text class="row-hours">
              {{ item.hours }}h
            </text>
            <text :class="['tag', item.status === '迟到' ? 'tag--warn' : 'tag--ok']">
              {{ item.status }}
            </text>
          </view>
        </template>
      </view>

      <view class="sp-footnote">
        <text class="sp-footnote-text">
          数据由本地引擎生成 · 仅用于演示
        </text>
      </view>
    </view>
  </AuthLayout>
</template>

