<script setup lang="ts">
import { reactive } from 'vue'
import { useAuthStore } from '@/store/auth'

const props = defineProps({
  loading: { type: Boolean },
  logincaptcha: { type: Object },
  captchaVerify: { type: Object },
})

const emit = defineEmits(['error', 'loading-change'])

const authStore = useAuthStore()

const passwordForm = reactive({
  username: 'demo',
  password: '123456',
})

async function handlePasswordLogin() {
  if (!passwordForm.username || !passwordForm.password) {
    emit('error', '请输入用户名和密码')
    return
  }

  // 滑块验证
  let verifyToken: string | undefined
  if (props.logincaptcha) {
    try {
      verifyToken = await props.captchaVerify?.()
    }
    catch {
      return
    }
  }

  emit('error', '')
  emit('loading-change', true)
  try {
    const { isSuccess, message } = await authStore.login({
      type: 'password',
      username: passwordForm.username,
      password: passwordForm.password,
      verifyToken,
    })
    if (!isSuccess)
      emit('error', message || '登录失败')
  }
  finally {
    emit('loading-change', false)
  }
}

</script>

<template>
  <view class="pwd-login">
    <view class="pwd-field">
      <input class="sp-input" v-model="passwordForm.username" placeholder="请输入用户名或手机号码" type="text" />
    </view>
    <view class="pwd-field">
      <input class="sp-input" v-model="passwordForm.password" password="true" placeholder="请输入密码" />
    </view>

    <view class="sp-btn pwd-btn sp-btn--block" @click="handlePasswordLogin">
        <text class="sp-btn-text">
          登 录
        </text>
      </view>
  </view>
</template>

<style lang="scss">
.pwd-login {
  display: flex;
  flex-direction: column;
}

.pwd-field {
  position: relative;
  margin-bottom: 24px;
  background: $bg-color;
  border-radius: 8px;
  padding: 0 12px;
}

.pwd-btn {
  margin-top: 40px;
  height: 88px;
  border-radius: 8px;
  font-size: 30px;
  font-weight: 600;
  background: linear-gradient(135deg, #3b4fe0 0%, #8b5cf6 100%);
  color: #fff;
  box-shadow: 0 12px 24px rgba(79, 70, 229, 0.28);
  transition: transform 0.15s ease;
}

/* #ifdef WEB */
.pwd-btn:active {
  transform: scale(0.97);
}

/* #endif */
</style>
