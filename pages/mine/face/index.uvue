}

.radio {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: 2px solid #dcdfea;
  box-sizing: border-box;
}

.radio--on {
