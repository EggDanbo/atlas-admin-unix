}

/* #endif */

.tip-index {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background-color: #eef2ff;
  font-size: 17px;
  font-weight: 600;
  color: #4f46e5;
}

.tip-text {
  flex: 1;
  min-width: 0;
  font-size: 21px;
  line-height: 1.5;
