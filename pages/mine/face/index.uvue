  background-color: rgba(255, 255, 255, 0.18);
  font-size: 18px;
  color: #fff;
}

/* #ifdef WEB */
.hero-pill .pill-dot {
  background-color: #fbbf24;
  box-shadow: 0 0 0 4px rgba(251, 191, 36, 0.22);
}

/* #endif */
/* #ifdef WEB */
