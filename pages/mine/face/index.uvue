}

.method-tag {
  flex-shrink: 0;
  padding: 2px 10px;
  border-radius: 999px;
  background-color: rgba(13, 148, 136, 0.1);
  font-size: 16px;
  color: #0d9488;
}

.method-desc {
  overflow: hidden;
  white-space: nowrap;
