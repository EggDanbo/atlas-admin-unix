  background-color: #eef2ff;
}

.method-icon--teal {
  background-color: #ecfdf5;
}

.method-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.method-title-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.method-title {
  font-size: 24px;
  font-weight: 600;
