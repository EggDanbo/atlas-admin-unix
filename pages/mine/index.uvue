<script setup lang="ts">
import type { CheckinStatus } from '@/api/checkin.ts'

import { computed, ref, watch } from 'vue'
import AuthLayout from '@/components/auth-layout/auth-layout.uvue'
import checkinApi from '@/api/checkin.ts'
import { useAppInfoStore } from '@/store/appinfo'
import { useAuthStore } from '@/store/auth'
import { routes } from '@/utils/router'

const authStore = useAuthStore()
const appInfoStore = useAppInfoStore()

const userInfo = computed(() => authStore.userInfo)
const isAdmin = computed(() => authStore.isAdmin)

const version = computed(() => {
  const raw = String(appInfoStore.version || '1.0.0001')
  return /^v/i.test(raw) ? raw : `v${raw}`
})
const avatarUrl = computed(() => userInfo.value?.avatarurl || userInfo.value?.faceurl || '')
const avatarText = computed(() => (userInfo.value?.name || 'A').charAt(0))
const teamText = computed(() => userInfo.value?.team_name || 'Atlas 总部')
const wknoText = computed(() => (userInfo.value?.wkno ? `工号 ${userInfo.value.wkno}` : ''))
const metaText = computed(() => [teamText.value, wknoText.value].filter(Boolean).join(' · '))
const mobileText = computed(() => {
  const mobile = String(userInfo.value?.mobile_number || '')
  return /^\d{11}$/.test(mobile) ? `${mobile.slice(0, 3)}****${mobile.slice(7)}` : mobile
})

const checkin = ref<CheckinStatus | null>(null)

async function loadCheckin() {
  if (!authStore.isLoggedIn) {
    checkin.value = null
    return
  }
  const { isSuccess, data } = await checkinApi.status()
  if (isSuccess && data)
    checkin.value = data
}

onPageShow(() => void loadCheckin())
// 登录态是异步恢复的：从 loading 切到 auth 后补一次数据，避免统计一直是「—」
watch(() => authStore.isLoggedIn, (loggedIn) => {
  if (loggedIn)
    void loadCheckin()
}, { immediate: true })

/** 今日打卡状态：未打卡 / 已上班 / 已完成（附带时间或工时） */
const duty = computed(() => {
  const today = checkin.value?.today
  if (!today?.inTime)
    return { key: 'idle', label: '未打卡', extra: '' }
  if (!today.outTime)
    return { key: 'in', label: '已上班', extra: today.inTime }

  const [inH, inM] = today.inTime.split(':').map(Number)
  const [outH, outM] = today.outTime.split(':').map(Number)
  let minutes = (outH * 60 + outM) - (inH * 60 + inM)
  if (minutes < 0)
    minutes += 24 * 60
  // 不足 1 小时显示分钟，否则保留一位小数的工时
  const extra = minutes < 1
    ? ''
    : minutes < 60 ? `${minutes}min` : `${Math.round((minutes / 60) * 10) / 10}h`
  return { key: 'done', label: '已完成', extra }
})

/** 本月考勤概览：出勤 / 迟到 / 加班 */
const monthStats = computed(() => {
  const month = checkin.value?.month
  return [
    { label: '本月出勤', value: month ? `${month.days}` : '—', unit: '天' },
    { label: '迟到', value: month ? `${month.late}` : '—', unit: '次' },
    { label: '加班', value: month ? `${month.overtime}` : '—', unit: '小时' },
  ]
})

function go(url: string) {
  uni.navigateTo({ url })
}

const aboutVisible = ref(false)
const companyText = computed(() => appInfoStore.companyname || 'Atlas Demo')

function openAbout() {
  aboutVisible.value = true
}

// 弹层在页面容器里，tabBar 的层级更高会压住底部按钮：打开时先隐藏 tabBar
watch(aboutVisible, (visible) => {
  const task = visible
    ? uni.hideTabBar({ animation: true })
    : uni.showTabBar({ animation: true })
  task.catch(() => {})
})

async function handleLogout() {
  const res = await uni.showModal({
    title: '退出登录',
    content: '退出后需要重新登录才能查看考勤与单据',
    confirmText: '退出',
    confirmColor: '#e11d48',
  })
  if (!res.confirm)
    return
  await authStore.logout()
}

</script>

<template>
  <view class="sp-page page">
    <AuthLayout>
      <!-- 个人卡：身份 + 本月考勤概览 -->
      <view class="hero">
        <view class="hero-glow" />
        <view class="hero-glow2" />

        <view class="hero-brand">
          <view class="brand-main">
            <view class="brand-mark">
              <text class="brand-bar brand-bar--1" />
              <text class="brand-bar brand-bar--2" />
              <text class="brand-bar brand-bar--3" />
            </view>
            <text class="brand-name">
              ATLAS
            </text>
            <text class="brand-sub">
              WORKSPACE
            </text>
          </view>

          <view class="hero-action" @click="go(routes.profile)">
            <text>个人资料</text>
            <text class="sp-icon-chevron" :style="{ color: 'rgba(255,255,255,0.82)' }">›</text>
          </view>
        </view>

        <view class="hero-main">
          <image v-if="avatarUrl" class="hero-avatar" :src="avatarUrl" mode="aspectFill" />
          <view v-else class="hero-avatar-text">
            {{ avatarText }}
          </view>

          <view class="hero-info">
            <view class="hero-title">
              <text class="hero-name">
                {{ userInfo?.name || '未登录' }}
              </text>

              <view
                :class="['hero-status', `hero-status--${duty.key}`]"
                @click="go(routes.checkin)"
              >
                <view class="status-dot" />
                <text class="status-label">
                  {{ duty.label }}
                </text>
                <text v-if="duty.extra" class="status-time">
                  {{ duty.extra }}
                </text>
              </view>
            </view>

            <text class="hero-meta">
              {{ metaText }}
            </text>
          </view>
        </view>

        <view class="hero-stats" @click="go(routes.checkinStats)">
          <view v-for="item in monthStats" :key="item.label" class="stat">
            <view class="stat-value">
              <text>{{ item.value }}</text>
              <text class="stat-unit">
                {{ item.unit }}
              </text>
            </view>
            <text class="stat-label">
              {{ item.label }}
            </text>
          </view>
        </view>
      </view>

      <!-- 账号与安全 -->
      <view class="panel">
        <view class="panel-head">
          <text class="panel-title">
            账号与安全
          </text>
        </view>

        <template v-if="!isAdmin">
          <view class="row" @click="go(routes.profile)">
            <text class="row-label">
              个人信息
            </text>
            <text class="row-value">
              {{ mobileText || '查看' }}
            </text>
            <text class="sp-icon-chevron" :style="{ color: '#c2c6d4' }">›</text>
          </view>
          <view class="row" @click="go(routes.facePhoto)">
            <text class="row-label">
              人脸采集
            </text>
            <text class="row-value">
              {{ userInfo?.faceurl ? '已采集' : '未采集' }}
            </text>
            <text class="sp-icon-chevron" :style="{ color: '#c2c6d4' }">›</text>
          </view>
          <view class="row" @click="go(routes.password)">
            <text class="row-label">
              修改密码
            </text>
            <text class="row-value" />
            <text class="sp-icon-chevron" :style="{ color: '#c2c6d4' }">›</text>
          </view>
        </template>
        <view v-else class="note">
          当前为管理员账号，个人考勤资料由后台统一维护
        </view>
      </view>

      <!-- 其他 -->
      <view class="panel">
        <view class="panel-head">
          <text class="panel-title">
            其他
          </text>
        </view>
        <view class="row" @click="openAbout">
          <text class="row-label">
            关于应用
          </text>
          <text class="row-value">
            {{ version }}
          </text>
          <text class="sp-icon-chevron" :style="{ color: '#c2c6d4' }">›</text>
        </view>
      </view>

      <view class="logout" @click="handleLogout">
        退出登录
      </view>

      <view class="sp-footnote">
        <text class="sp-footnote-text">
          数据由本地引擎生成 · 仅用于演示
        </text>
      </view>

      <!-- 关于应用 -->
      <view v-if="aboutVisible" class="sp-mask" @click="aboutVisible = false">
        <view class="sp-sheet" @click.stop>
        <view class="about">
          <view class="about-grip" />

          <view class="about-logo">
            <text class="brand-bar brand-bar--1" />
            <text class="brand-bar brand-bar--2" />
            <text class="brand-bar brand-bar--3" />
          </view>

          <text class="about-name">
            {{ appInfoStore.appname }}
          </text>
          <view class="about-chip">
            {{ version }}
          </view>
          <text class="about-desc">
            移动考勤与协同工作台，支持打卡、审批、通讯录与数据看板
          </text>

          <view class="about-list">
            <view class="about-row">
              <text class="about-label">
                开发者
              </text>
              <text class="about-value">
                {{ companyText }}
              </text>
            </view>
            <view class="about-row">
              <text class="about-label">
                运行环境
              </text>
              <text class="about-value">
                H5 / 微信小程序
              </text>
            </view>
            <view class="about-row">
              <text class="about-label">
                数据来源
              </text>
              <text class="about-value">
                本地演示数据
              </text>
            </view>
          </view>

          <view class="about-actions">
            <view class="about-close" @click="aboutVisible = false">
              知道了
            </view>
          </view>

          <text class="about-copy">
            © 2026 {{ companyText }} · 仅供演示
          </text>
        </view>
              </view>
      </view>
    </AuthLayout>
  </view>
</template>

