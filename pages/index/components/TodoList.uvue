<script setup lang="ts">
import { onMounted, ref } from 'vue'
import api from '@/api/message/index.ts'
import { routes } from '@/utils/router'

const todoData = ref<any[]>([])
const total = ref(0)

async function getList() {
  const { isSuccess, data } = await api.search({
    page: 1,
    pagesize: 3,
    kind: 'ATLAS',
    unread: false,
  })
  if (!isSuccess || !data)
    return
  const list = Array.isArray(data.list) ? data.list : []
  todoData.value = list.slice(0, 3)
  total.value = Number(data.totalcount || list.length)
}

onMounted(() => getList())

/** 进消息中心时带上「待办」类型，免去再筛一次 */
function goTodoList() {
  uni.navigateTo({ url: `${routes.userMessage}?types=0` })
}

function handleMore() {
  goTodoList()
}

function handleItemClick() {
  // 业务详情页已不在演示范围内，统一进消息中心
  goTodoList()
}

function typeLabel(types: number) {
  return ['待办', '消息', '通知'][Number(types)] || '消息'
}

</script>

<template>
  <view class="section">
    <view class="section-head" @click="handleMore">
      <view class="head-left">
        <text class="section-title">
          待办事项
        </text>
        <text v-if="total" class="section-count">
          {{ total }}
        </text>
      </view>
      <view class="head-more">
        <text class="head-more-text">
          查看全部
        </text>
        <text class="sp-icon-chevron" :style="{ color: '#9aa0b4' }">›</text>
      </view>
    </view>

    <view v-if="todoData.length" class="list">
      <view
        v-for="item in todoData"
        :key="item.id"
        class="item"
        @click="handleItemClick(item)"
      >
        <view :class="['dot', item.types === 0 ? 'dot--todo' : 'dot--msg']" />
        <view class="item-main">
          <view class="item-title-row">
            <text class="item-title">
              {{ item.title }}
            </text>
            <text class="item-tag">
              {{ typeLabel(item.types) }}
            </text>
          </view>
          <text class="item-desc">
            {{ item.user_name }} · {{ item.ctime }}
          </text>
        </view>
        <text class="sp-icon-chevron" :style="{ color: '#c4c8d6' }">›</text>
      </view>
    </view>

    <SpEmpty v-else description="暂无待办" />
  </view>
</template>

