<script setup lang="ts">
import { routes } from '@/utils/router'

interface MenuItem {
  glyph: string
  label: string
  color: string
  bg: string
  url: string
}

/**
 * 管理端菜单
 *
 * 移动端只保留「必须在手机上完成」的动作：审批、单据、组织、考勤、看板、消息。
 * 台账录入、报表设计、权限配置这类重操作留给 PC 后台。
 */
const menuList: MenuItem[] = [
  { glyph: '⚙', label: '考勤规则', color: '#4f46e5', bg: '#eef2ff', url: routes.ruleList },
  { glyph: '📋', label: '我的申请', color: '#e11d48', bg: '#fff1f2', url: routes.myApply },
  { glyph: '📝', label: '请假申请', color: '#0d9488', bg: '#ecfdf5', url: routes.applyLeave },
  { glyph: '👥', label: '组织通讯录', color: '#d97706', bg: '#fffbeb', url: routes.contact },
  { glyph: '🙋', label: '成员管理', color: '#7c3aed', bg: '#f5f3ff', url: routes.team },
  { glyph: '📊', label: '考勤统计', color: '#0891b2', bg: '#ecfeff', url: routes.checkinStats },
  { glyph: '📈', label: '数据看板', color: '#0284c7', bg: '#eff6ff', url: routes.board },
  { glyph: '🔔', label: '消息中心', color: '#be185d', bg: '#fdf2f8', url: routes.userMessage },
]

function handleMenuClick(item: MenuItem) {
  uni.navigateTo({ url: item.url })
}

</script>

<template>
  <view class="section">
    <view class="section-head">
      <text class="section-title">
        管理菜单
      </text>
      <text class="section-hint">
        考勤 · 单据 · 数据
      </text>
    </view>

    <view class="grid">
      <view
        v-for="item in menuList"
        :key="item.label"
        class="tile"
        @click="handleMenuClick(item)"
      >
        <view class="tile-icon" :style="{ backgroundColor: item.bg }">
          <text class="tile-glyph" :style="{ color: item.color }">
            {{ item.glyph }}
          </text>
        </view>
        <text class="tile-label">
          {{ item.label }}
        </text>
      </view>
    </view>
  </view>
</template>

