<script setup lang="ts">
import { computed, onMounted, ref } from 'vue'
import userAuth from '@/api/identity/profile.ts'
import { useAuthStore } from '@/store/auth'

const authStore = useAuthStore()
const userInfo = computed(() => authStore.userInfo)

const stats = ref<any[]>([])
async function getStats() {
  const { isSuccess, data } = await userAuth.stats()
  if (!isSuccess || !Array.isArray(data))
    return
  stats.value = data
}

onPageShow(() => getStats())
onMounted(() => getStats())

const greeting = computed(() => {
  const hour = new Date().getHours()
  if (hour < 6)
    return '夜深了'
  if (hour < 9)
    return '早上好'
  if (hour < 12)
    return '上午好'
  if (hour < 14)
    return '中午好'
  if (hour < 18)
    return '下午好'
  return '晚上好'
})

const dateText = computed(() => {
  const now = new Date()
  const week = ['日', '一', '二', '三', '四', '五', '六'][now.getDay()]
  return `${now.getMonth() + 1} 月 ${now.getDate()} 日 · 星期${week}`
})

const avatarUrl = computed(() => userInfo.value?.avatarurl || userInfo.value?.faceurl || '')
const displayName = computed(() => userInfo.value?.name || userInfo.value?.nickname || '访客')
const teamName = computed(() => userInfo.value?.team_name || 'Atlas 总部')

</script>

<template>
  <view class="hero">
    <view class="hero-glow" />
    <view class="hero-glow2" />

    <view class="hero-brand">
      <view class="brand-mark">
        <text class="brand-bar brand-bar--1" />
        <text class="brand-bar brand-bar--2" />
        <text class="brand-bar brand-bar--3" />
      </view>
      <text class="brand-name">
        ATLAS
      </text>
      <text class="brand-sub">
        WORKSPACE
      </text>
    </view>

    <view class="hero-main">
      <view class="hero-info">
        <text class="hero-date">
          {{ dateText }}
        </text>
        <text class="hero-greeting">
          {{ greeting }}，{{ displayName }}
        </text>
        <text class="hero-meta">
          {{ teamName }}
        </text>
      </view>
      <image v-if="avatarUrl" class="hero-avatar" :src="avatarUrl" mode="aspectFill" />
      <view v-else class="hero-avatar-text">
        {{ displayName.charAt(0) }}
      </view>
    </view>

    <view v-if="stats.length" class="hero-stats">
      <view v-for="item in stats" :key="item.label" class="stat">
        <text class="stat-value">
          {{ item.value }}
        </text>
        <text class="stat-label">
          {{ item.label }}
        </text>
      </view>
    </view>
  </view>
</template>

