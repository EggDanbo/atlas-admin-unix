  padding: 39rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: #9aa0b4;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 21rpx;
  padding: 23rpx 0;
  border-bottom: 1.2rpx solid #f1f2f7;
}

/* #ifdef WEB */
.row:last-child {
  border-bottom: none;
}

/* #endif */
/* #ifdef WEB */
.row:active {
  opacity: 0.72;
}

/* #endif */

.avatar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 83rpx;
  height: 83rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #eef2ff 0%, #e5e9ff 100%);
  font-size: 30rpx;
  font-weight: 600;
  color: #4f46e5;
}

.avatar--off {
  background: #f2f3f7;
  color: #b3b8c8;
}

.row-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 7rpx;
  min-width: 0;
}

.row-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
}

.name {
  font-size: 29rpx;
  font-weight: 600;
  color: #1c1c2e;
}

.name--off {
  color: #9aa0b4;
}

.tag {
  padding: 2rpx 12rpx;
  border-radius: 7rpx;
  font-size: 21rpx;
}

.tag--on {
  color: #0d9488;
  background-color: #ecfdf5;
}

.tag--off {
  color: #6b7080;
  background-color: #f2f3f7;
}

.meta {
  font-size: 24rpx;
  color: #9aa0b4;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.code {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #c1c6d4;
  letter-spacing: 0.5rpx;
}
</style>
