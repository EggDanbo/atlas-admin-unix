<script setup lang="ts">
import type { DashboardSummary } from '@/api/dashboard.ts'

import { computed, ref } from 'vue'
import AuthLayout from '@/components/auth-layout/auth-layout.uvue'
import PageNavbar from '@/components/page-navbar/page-navbar.uvue'
import dashboardApi from '@/api/dashboard.ts'

const summary = ref<DashboardSummary | null>(null)
const loading = ref(true)

async function load() {
  loading.value = true
  const { isSuccess, data } = await dashboardApi.summary()
  if (isSuccess && data)
    summary.value = data
  loading.value = false
}

onPageShow(() => void load())

const trend = computed(() => summary.value?.trend || [])
const maxTrend = computed(() => Math.max(...trend.value.map(d => d.value), 1))
const depts = computed(() => summary.value?.depts || [])
const maxDept = computed(() => Math.max(...depts.value.map(d => d.total), 1))
const types = computed(() => summary.value?.types || [])

const today = computed(() => {
  const now = new Date()
  return `${now.getMonth() + 1} 月 ${now.getDate()} 日`
})

</script>

<template>
  <AuthLayout>
    <view class="sp-page page">
      <PageNavbar title="数据看板" />

      <!-- 概览 -->
      <view class="hero">
        <view class="hero-top">
          <text class="hero-label">
            运营概览
          </text>
          <text class="hero-date">
            {{ today }}
          </text>
        </view>
        <view class="hero-main">
          <text class="hero-value">
            {{ summary?.pending ?? 0 }}
          </text>
          <text class="hero-unit">
            单待处理
          </text>
        </view>
        <text class="hero-hint">
          审批通过率 {{ summary?.rate ?? 0 }}% · 共 {{ summary?.kpis[1]?.value ?? 0 }} 张单据
        </text>
      </view>

      <!-- 指标 -->
      <view class="grid">
        <view v-for="kpi in summary?.kpis || []" :key="kpi.label" class="tile">
          <view class="tile-value">
            <text>{{ kpi.value }}</text>
            <text class="tile-unit">
              {{ kpi.unit }}
            </text>
          </view>
          <text class="tile-label">
            {{ kpi.label }}
          </text>
        </view>
      </view>

      <!-- 走势 -->
      <view class="card">
        <view class="card-head">
          <text class="card-title">
            近 7 日单据量
          </text>
          <text class="card-hint">
            单位：单
          </text>
        </view>
        <view v-if="loading && !trend.length" class="tip">
          加载中…
        </view>
        <view v-else class="chart">
          <view v-for="day in trend" :key="day.label" class="bar">
            <text class="bar-value">
              {{ day.value }}
            </text>
            <view class="bar-track">
              <view class="bar-fill" :style="{ height: `${Math.round((day.value / maxTrend) * 100)}%` }" />
            </view>
            <text class="bar-label">
              {{ day.label }}
            </text>
          </view>
        </view>
      </view>

      <!-- 部门分布 -->
      <view class="card">
        <view class="card-head">
          <text class="card-title">
            部门分布
          </text>
          <text class="card-hint">
            {{ depts.length }} 个部门
          </text>
        </view>
        <view v-for="dept in depts" :key="dept.name" class="row">
          <view class="row-head">
            <text class="row-name">
              {{ dept.name }}
            </text>
            <text class="row-value">
              {{ dept.total }} 单 · 待处理 {{ dept.pending }}
            </text>
          </view>
          <view class="track">
            <view class="fill" :style="{ width: `${Math.round((dept.total / maxDept) * 100)}%` }" />
          </view>
        </view>
      </view>

      <!-- 单据类型 -->
      <view class="card">
        <view class="card-head">
          <text class="card-title">
            单据类型 TOP5
          </text>
          <text class="card-hint">
            占比
          </text>
        </view>
        <view v-for="type in types" :key="type.name" class="type-row">
          <text class="type-name">
            {{ type.name }}
          </text>
          <view class="type-track">
            <view class="type-fill" :style="{ width: `${type.ratio}%` }" />
          </view>
          <text class="type-value">
            {{ type.value }}
          </text>
        </view>
      </view>

      <view class="sp-footnote">
        <text class="sp-footnote-text">
          数据由本地引擎实时汇总 · 仅用于演示
        </text>
      </view>
    </view>
  </AuthLayout>
</template>

