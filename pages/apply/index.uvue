<script setup lang="ts">
import { computed, ref } from 'vue'
import AuthLayout from '@/components/auth-layout/auth-layout.uvue'
import PageNavbar from '@/components/page-navbar/page-navbar.uvue'
import { showToast } from '@/components/sp-toast/toast.ts'
import applyApi from '@/api/apply.ts'
import { safeBack } from '@/utils/auth'

type ApplyType = 'leave' | 'overtime'

const type = ref<ApplyType>('leave')
const startDate = ref('')
const endDate = ref('')
const startTime = ref('09:00')
const leaveKind = ref('事假')
const hours = ref(2)
const reason = ref('')
const submitting = ref(false)
/** 已提交成功：防止触摸 + click 双重事件重复下单 */
const submitted = ref(false)

const today = new Date()
const todayText = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`

onLoad((options) => {
  type.value = options?.type === 'overtime' ? 'overtime' : 'leave'
  startDate.value = todayText
  endDate.value = todayText
})

const title = computed(() => (type.value === 'leave' ? '请假申请' : '加班申请'))

/** 请假天数（含首尾） */
const leaveDays = computed(() => {
  if (!startDate.value || !endDate.value)
    return 1
  const diff = (new Date(endDate.value).getTime() - new Date(startDate.value).getTime()) / 86400000
  return Math.max(1, Math.round(diff) + 1)
})

const durationText = computed(() => (type.value === 'leave' ? `${leaveDays.value} 天` : `${hours.value} 小时`))

const canSubmit = computed(() => !!startDate.value && !!reason.value.trim() && !submitting.value)

function switchType(next: ApplyType) {
  type.value = next
}

function onDateChange(field: 'start' | 'end', e: any) {
  const value = e.detail?.value as string
  if (field === 'start') {
    startDate.value = value
    if (endDate.value < value)
      endDate.value = value
  }
  else {
    endDate.value = value
  }
}

function onTimeChange(e: any) {
  startTime.value = e.detail?.value as string
}

async function submit() {
  if (submitting.value || submitted.value)
    return
  if (!startDate.value) {
    showToast(type.value === 'leave' ? '请选择开始日期' : '请选择加班日期')
    return
  }
  if (!reason.value.trim()) {
    showToast('请填写申请事由')
    return
  }
  submitting.value = true
  const { isSuccess, data } = await applyApi.submit({
    type: type.value,
    startDate: startDate.value,
    endDate: type.value === 'leave' ? endDate.value : startDate.value,
    startTime: type.value === 'overtime' ? startTime.value : '',
    duration: durationText.value,
    kind: type.value === 'leave' ? leaveKind.value : '加班',
    reason: reason.value,
  })
  submitting.value = false
  if (!isSuccess) {
    showToast('提交失败，请重试')
    return
  }
  submitted.value = true
  await uni.showModal({
    title: '提交成功',
    content: `单号 ${data?.no || '—'}，已进入审批流程`,
    showCancel: false,
    confirmText: '知道了',
  })
  safeBack()
}

</script>

<template>
  <AuthLayout>
    <view class="sp-page page">
      <PageNavbar :title="title" />

      <view class="segment">
        <view :class="['segment-item', type === 'leave' ? 'segment-item--active' : '']" @click="switchType('leave')">
          请假
        </view>
        <view :class="['segment-item', type === 'overtime' ? 'segment-item--active' : '']" @click="switchType('overtime')">
          加班
        </view>
      </view>

      <view class="card">
        <picker mode="date" :value="startDate" @change="onDateChange('start', $event)">
          <view class="row">
            <text class="row-label">
              {{ type === 'leave' ? '开始日期' : '加班日期' }}
            </text>
            <text class="row-value">
              {{ startDate || '请选择' }}
            </text>
          </view>
        </picker>

        <picker v-if="type === 'leave'" mode="date" :value="endDate" @change="onDateChange('end', $event)">
          <view class="row">
            <text class="row-label">
              结束日期
            </text>
            <text class="row-value">
              {{ endDate || '请选择' }}
            </text>
          </view>
        </picker>

        <picker v-else mode="time" :value="startTime" @change="onTimeChange">
          <view class="row">
            <text class="row-label">
              开始时间
            </text>
            <text class="row-value">
              {{ startTime }}
            </text>
          </view>
        </picker>

        <view class="row">
          <text class="row-label">
            时长
          </text>
          <text class="row-value row-value--strong">
            {{ durationText }}
          </text>
        </view>

        <view class="row row--last">
          <text class="row-label">
            {{ type === 'leave' ? '请假类型' : '加班时长' }}
          </text>
          <view class="chips">
            <template v-if="type === 'leave'">
              <text
                v-for="kind in ['事假', '病假', '年假']" :key="kind"
                :class="['chip', leaveKind === kind ? 'chip--active' : '']"
                @click="leaveKind = kind"
              >
                {{ kind }}
              </text>
            </template>
            <template v-else>
              <text
                v-for="h in [1, 2, 3, 4]" :key="h"
                :class="['chip', hours === h ? 'chip--active' : '']"
                @click="hours = h"
              >
                {{ h }}h
              </text>
            </template>
          </view>
        </view>
      </view>

      <view class="card">
        <view class="card-title">
          申请事由
        </view>
        <textarea
          v-model="reason"
          class="textarea"
          :maxlength="200"
          placeholder="请简要说明申请原因，便于审批人了解"
          :placeholder-class="'placeholder'"
        />
        <view class="counter">
          {{ reason.length }}/200
        </view>
      </view>

      <view class="tips">
        · 提交后进入直属主管审批，可在「我的申请」中查看进度
      </view>

      <view class="submit-wrap">
        <view :class="['submit', canSubmit ? '' : 'submit--disabled']" @click="submit">
          {{ submitting ? '提交中…' : '提交申请' }}
        </view>
      </view>
    </view>
  </AuthLayout>
</template>

<style lang="scss">
.page {
  min-height: 100vh;
  min-height: 100dvh;
  padding-bottom: calc(160px + env(safe-area-inset-bottom, 0px));
  background-color: #f5f6fa;
}

/* 请假 / 加班切换 */
.segment {
  display: flex;
  gap: 8px;
  margin: 16px 16px 0;
  padding: 6px;
  border-radius: 999px;
  background-color: #eceefa;
}

.segment-item {
  flex: 1;
  padding: 12px 0;
  border-radius: 999px;
  text-align: center;
  font-size: 24px;
  color: #6b7080;
  transition: all 0.2s ease;
}

.segment-item--active {
  background-color: #fff;
  color: #4f46e5;
  font-weight: 600;
  box-shadow: 0 4px 12px rgba(59, 79, 224, 0.12);
}

.card {
  margin: 16px 16px 0;
  padding: 6px 24px;
  border-radius: 18px;
  background-color: #fff;
  box-shadow: 0 8px 24px rgba(23, 23, 64, 0.05);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 0;
  border-bottom: 1px solid #f1f2f7;
}

.row--last {
  border-bottom: none;
}

.row-label {
  font-size: 24px;
  color: #23263a;
}

.row-value {
  font-size: 24px;
  color: #6b7080;
}

.row-value--strong {
  font-weight: 600;
  color: #4f46e5;
}

/* 类型 / 时长标签 */
.chips {
  display: flex;
  gap: 10px;
}

.chip {
  padding: 8px 20px;
  border-radius: 999px;
  background-color: #f4f5fb;
  font-size: 21px;
  color: #6b7080;
}

.chip--active {
  background-color: #eef2ff;
  color: #4f46e5;
  font-weight: 600;
}

/* 事由 */
.card-title {
  padding: 18px 0 8px;
  font-size: 26px;
  font-weight: 600;
  color: #1c1c2e;
}

.textarea {
  width: 100%;
  height: 180px;
  padding: 16px;
  margin-top: 6px;
  border-radius: 14px;
  background-color: #f7f8fc;
  font-size: 24px;
  color: #23263a;
  box-sizing: border-box;
}

.placeholder {
  color: #b3b8c8;
}

.counter {
  padding: 8px 4px 16px;
  text-align: right;
  font-size: 19px;
  color: #b3b8c8;
}

.tips {
  margin: 16px 16px 0;
  font-size: 20px;
  line-height: 1.6;
  color: #9aa0b4;
}

/* 底部提交 */
.submit-wrap {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16px 16px calc(20px + env(safe-area-inset-bottom, 0px));
  background: linear-gradient(180deg, rgba(245, 246, 250, 0) 0%, #f5f6fa 40%);
}

.submit {
  padding: 24px 0;
  border-radius: 999px;
  background: linear-gradient(135deg, #3b4fe0 0%, #7c6cf6 100%);
  box-shadow: 0 12px 24px rgba(59, 79, 224, 0.24);
  text-align: center;
  font-size: 28px;
  font-weight: 600;
  color: #fff;
}

.submit--disabled {
  opacity: 0.5;
  box-shadow: none;
}

/* #ifdef WEB */
.submit:active {
  opacity: 0.85;
}

/* #endif */
</style>
