<script setup lang="ts">
defineProps({
  item: { type: Object },
  showCategory: { type: Boolean, default: true },
})

const emit = defineEmits([])

/** 状态 → 标签配色 */
function tone(status: string) {
  if (status === '待审批')
    return 'wait'
  if (status === '审批中')
    return 'progressing'
  if (status === '已通过')
    return 'pass'
  if (status === '已退回')
    return 'back'
  return 'muted'
}

</script>

<template>
  <view class="card" @click="emit('view', item)">
    <view class="card-head">
      <view class="card-heading">
        <text v-if="showCategory" class="card-cat">
          {{ item.biz_category }}
        </text>
        <text class="card-title">
          {{ item.biz_title }}
        </text>
      </view>
      <text :class="['tag', `tag--${tone(item.status)}`]">
        {{ item.status }}
      </text>
    </view>

    <view class="card-meta">
      <text class="card-no">
        {{ item.biz_no }}
      </text>
      <text class="card-dot">
        ·
      </text>
      <text>{{ item.team_name }}</text>
    </view>

    <view class="card-foot">
      <text class="card-time">
        {{ item.ctime }}
      </text>
      <text class="card-link">
        查看详情
      </text>
    </view>
  </view>
</template>

