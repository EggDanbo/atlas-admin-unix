/* 工作日：说明行 + 一排轻量圆形格子 */
.slot-days-block {
  margin-top: 16rpx;
}

.slot-caption {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.slot-label {
  flex-shrink: 0;
  font-size: 18rpx;
  color: #9aa0b4;
}

