  font-size: 18rpx;
  color: #9aa0b4;
}

.slot-days {
  display: flex;
  flex-direction: row;
  gap: 10rpx;
}

.slot-day {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: 16rpx;
  background-color: #fff;
  font-size: 22rpx;
  color: #8a90a3;
  transition:
  background-color 0.15s ease,
  color 0.15s ease;

  /* 已被其它班次占用的日子不可选 */
}

.slot-day--on {
  background-color: #4f46e5;
  font-weight: 600;
  color: #fff;
}

.slot-day--locked {
  background-color: #e9ebf2;
  color: #aab0c0;
}

