  padding: 60rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: #9aa0b4;
}

/* 概览 */
.hero {
  margin: 16rpx 16rpx 0;
  padding: 26rpx 26rpx 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #3b4fe0 0%, #7c6cf6 100%);
  box-shadow: 0 16rpx 30rpx rgba(59, 79, 224, 0.24);
}

.hero-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

