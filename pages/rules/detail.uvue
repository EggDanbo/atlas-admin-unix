  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background-color: rgba(255, 255, 255, 0.18);
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.92);
}

.hero-status {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 600;
  background-color: rgba(255, 255, 255, 0.92);
}

.hero-status--on {
  color: #0d9488;
}

.hero-status--off {
  color: #6b7080;
}

.hero-name {
  display: block;
  margin-top: 18rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.hero-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.78);
}

.hero-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 19rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.6);
}

/* 排班班次列表 */
.slots {
  padding-top: 14rpx;
}

.slot {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background-color: #f7f8fc;
}

.slot-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.slot-title {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}

.slot-name {
  font-size: 23rpx;
  font-weight: 600;
  color: #23263a;
}

.slot-cross {
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  background-color: #fff7ed;
  font-size: 17rpx;
  color: #b45309;
}

.slot-time {
  font-size: 22rpx;
  color: #6b7080;
  font-variant-numeric: tabular-nums;
}

.slot-hours {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #4f46e5;
}

/* 卡片 */
.ways {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 10rpx;
  padding: 16rpx 0 6rpx;
}

.way {
  padding: 8rpx 18rpx;
  border-radius: 10rpx;
  background-color: #eef2ff;
  font-size: 21rpx;
  color: #4f46e5;
}

/* 说明 */
.note {
  margin: 20rpx 16rpx 0;
}

.note-line {
  display: block;
  font-size: 20rpx;
  line-height: 1.8;
  color: #9aa0b4;
}

/* 操作 */
.actions {
  display: flex;
  flex-direction: row;
  gap: 14rpx;
  margin: 16rpx 16rpx 0;
}

.btn {
  flex: 1;
  padding: 22rpx 0;
  border-radius: 999rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
}

.btn--ghost {
  border: 1rpx solid #e5e7f0;
  background-color: #fff;
  color: #4a4f60;
}

/* #ifdef WEB */
.btn--ghost:active {
  background-color: #f7f8fc;
}

/* #endif */
.btn--primary {
  background: linear-gradient(135deg, #3b4fe0 0%, #7c6cf6 100%);
  color: #fff;
  box-shadow: 0 10rpx 22rpx rgba(59, 79, 224, 0.26);
}

.btn--disabled {
  opacity: 0.5;
}

/* 排班日历 */
.divider {
  margin: 6rpx 0 0;
  border-top: 1rpx solid #f1f2f7;
}

.cal-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  padding-top: 18rpx;
}

.cal-title {
  font-size: 25rpx;
  font-weight: 600;
  color: #1c1c2e;
}

.cal-hint {
  font-size: 20rpx;
  color: #9aa0b4;
}

.cal-nav {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 30rpx;
  padding: 14rpx 0 8rpx;
}

.cal-arrow {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background-color: #f4f5fb;
  font-size: 26rpx;
  line-height: 1;
  color: #4f46e5;
}

.cal-month {
  font-size: 22rpx;
  font-weight: 600;
  color: #23263a;
}

.cal-week {
  display: flex;
  flex-direction: row;
  padding-bottom: 4rpx;
}

.cal-week-text {
  flex: 1;
  text-align: center;
  font-size: 18rpx;
  color: #9aa0b4;
}

.cal-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.cal-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  width: 14.285%;
  border: 2rpx solid transparent;
  background-clip: padding-box;
  height: 58rpx;
  border-radius: 10rpx;
}

.cal-cell--blank {
  visibility: hidden;
}

.cal-cell--on {
  background-color: #f3f5ff;
}

.cal-day {
  font-size: 20rpx;
  color: #23263a;
  font-variant-numeric: tabular-nums;
}

.cal-tag {
  height: 18rpx;
  font-size: 14rpx;
  line-height: 18rpx;
  color: #5b6bd6;
}

.cal-tag--cont {
  color: #b45309;
}

.cal-summary {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 0 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #f1f2f7;
}

.cal-summary-text {
  font-size: 19rpx;
  color: #9aa0b4;
}

/* 排班表导航 */
.roster-nav {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 8rpx 0 2rpx;
}

/* #ifdef WEB */
.roster-nav .cal-nav {
  padding: 8rpx 0;
  gap: 24rpx;
}

/* #endif */

.range-tabs {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 4rpx;
  border-radius: 999rpx;
  background-color: #f4f5fb;
}

.range-tab {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  color: #6b7080;
}

.range-tab--on {
  background-color: #fff;
  color: #4f46e5;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(23, 23, 64, 0.08);
}
</style>
