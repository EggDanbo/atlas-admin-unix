  margin: 14rpx 16rpx 0;
  padding: 20rpx 24rpx 16rpx;
  border-radius: 18rpx;
  background-color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(23, 23, 64, 0.05);
}

/* #ifdef WEB */
.card:active {
  opacity: 0.88;
}

/* #endif */

.card-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.card-title {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.card-name {
  font-size: 29rpx;
  font-weight: 600;
  color: #1c1c2e;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 模式徽章 */
.mode {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
