<script setup lang="ts">
import type { AttendanceRule } from '@/api/rules.ts'
import SpSearchBar from '@/components/sp-search-bar/sp-search-bar.uvue'
import SpEmpty from '@/components/sp-empty/sp-empty.uvue'

import { computed, ref } from 'vue'
import AuthLayout from '@/components/auth-layout/auth-layout.uvue'
import PageNavbar from '@/components/page-navbar/page-navbar.uvue'
import rulesApi from '@/api/rules.ts'
import { modeLabel, ruleMainText, ruleModeHint } from '@/utils/attendance'
import { routes } from '@/utils/router'

const list = ref<AttendanceRule[]>([])
const keyword = ref('')
const loading = ref(true)

async function load() {
  loading.value = true
  const { isSuccess, data } = await rulesApi.list({
    page: 1,
    pagesize: 50,
    filter: keyword.value.trim() || undefined,
  })
  if (isSuccess && data)
    list.value = data.list || []
  loading.value = false
}

onPageShow(() => void load())

const activeCount = computed(() => list.value.filter(item => item.status === 1).length)

const modeCount = computed(() => {
  const count: Record<string, number> = { fixed: 0, free: 0, shift: 0 }
  list.value.forEach((item) => {
    const key = item.mode || 'fixed'
    count[key] = (count[key] || 0) + 1
  })
  return [
    { key: 'fixed', label: '固定班次', count: count.fixed },
    { key: 'free', label: '自由打卡', count: count.free },
    { key: 'shift', label: '排班制', count: count.shift },
  ]
})

function onSearch() {
  void load()
}

function clearKeyword() {
  keyword.value = ''
  void load()
}

function openDetail(item: AttendanceRule) {
  uni.navigateTo({ url: `${routes.ruleDetail}?id=${item.id}` })
}

function createRule() {
  uni.navigateTo({ url: routes.ruleEdit })
}

</script>

<template>
  <AuthLayout>
    <view class="sp-page sp-page--with-fab page">
      <PageNavbar title="考勤规则" />

      <view class="toolbar">
        <SpSearchBar
          v-model="keyword"
          :inset="false"
          placeholder="搜索规则名称或适用部门"
          @confirm="onSearch"
          @clear="clearKeyword"
        />

        <view class="summary">
          <text class="summary-text">
            共 {{ list.length }} 条规则
          </text>
          <text class="summary-hint">
            启用 {{ activeCount }}
          </text>
        </view>

        <view class="mode-stats">
          <view v-for="item in modeCount" :key="item.key" class="mode-stat">
            <text :class="['mode-dot', `mode-dot--${item.key}`]" />
            <text class="mode-stat-text">
              {{ item.label }} {{ item.count }}
            </text>
          </view>
        </view>
      </view>

      <view v-if="loading && !list.length" class="tip">
        加载中…
      </view>
      <SpEmpty v-else-if="!list.length" description="还没有考勤规则，点右下角新建" />
      <template v-else>
        <view
          v-for="item in list"
          :key="item.id"
          class="card"
          @click="openDetail(item)"
        >
          <view class="card-head">
            <view class="card-title">
              <text class="card-name">
                {{ item.name }}
              </text>
              <text :class="['mode', `mode--${item.mode || 'fixed'}`]">
                {{ modeLabel(item.mode) }}
              </text>
            </view>
            <text :class="['tag', item.status === 1 ? 'tag--on' : 'tag--off']">
              {{ item.status === 1 ? '启用' : '停用' }}
            </text>
          </view>

          <view class="meta">
            <text>{{ item.scope }}</text>
            <text class="dot">
              ·
            </text>
            <text>{{ item.member_count }} 人</text>
          </view>

          <view class="shift">
            <text class="shift-time">
              {{ ruleMainText(item) }}
            </text>
            <text class="shift-tag">
              {{ ruleModeHint(item) }}
            </text>
          </view>

          <view class="chips">
            <text v-for="way in item.ways" :key="way" class="chip">
              {{ way }}
            </text>
            <text class="chip">
              {{ item.gps_range }}m
            </text>
          </view>

          <view class="card-foot">
            <text class="card-time">
              更新 {{ item.utime }}
            </text>
            <text class="card-link">
              查看详情
            </text>
          </view>
        </view>
      </template>

      <view class="fab" @click="createRule">
        <text class="fab-plus">
          +
        </text>
      </view>
    </view>
  </AuthLayout>
</template>

<style lang="scss">
