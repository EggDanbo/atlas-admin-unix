{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": false,
    "jsx": "preserve",
    "sourceMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["@dcloudio/types"],
    "lib": ["esnext", "dom"]
  },
  "include": ["**/*.uvue", "**/*.uts", "**/*.ts", "**/*.vue", "**/*.d.ts"],
  "exclude": ["node_modules", "unpackage", "docs"]
}
