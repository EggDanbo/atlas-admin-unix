<script setup lang="ts">
import type { FilterOption } from './types.ts'
import { computed, ref } from 'vue'

const props = defineProps({
  modelValue: { type: String, default: '' },
  options: { type: Array },
})

const emit = defineEmits(['change', 'update:modelValue'])

const open = ref(false)

const current = computed(() => props.options.find(opt => opt.key === props.modelValue))
const currentLabel = computed(() => current.value?.label ?? props.options[0]?.label ?? '')

function toggle() {
  open.value = !open.value
}

function select(option: FilterOption) {
  open.value = false
  if (option.key === props.modelValue)
    return
  emit('update:modelValue', option.key)
  emit('change', option)
}

</script>

<template>
  <view class="wrap">
    <view
      data-role="filter-trigger"
      :class="['trigger', (open || !!modelValue) && 'trigger--active']"
      @click="toggle"
    >
      <text class="label">
        {{ currentLabel }}
      </text>
      <view :class="['chevron', open && 'chevron--up']" />
    </view>

    <view v-if="open" class="dropdown">
      <view
        v-for="option in options"
        :key="option.key || 'all'"
        data-role="filter-option"
        :class="['option', modelValue === option.key && 'option--active']"
        @click="select(option)"
      >
        <text class="option-label">
          {{ option.label }}
        </text>
        <text v-if="modelValue === option.key" class="option-check">
          ✓
        </text>
      </view>
    </view>

    <!-- 点击空白关闭 -->
    <view v-if="open" class="mask" @click="open = false" />
  </view>
</template>

<style lang="scss">
.wrap {
  position: relative;
  z-index: 60;
}

.trigger {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 10px 22px;
  border-radius: 14px;
  border: 1px solid #e9ecf4;
  background-color: #fff;
  font-size: 22px;
  color: #4a4f60;
}

.trigger--active {
  border-color: #d9defb;
  background-color: #eef2ff;
  color: #4f46e5;
  font-weight: 600;
}

.label {
  white-space: nowrap;
}

.chevron {
  width: 12px;
  height: 12px;
  margin-top: -6px;
  border-right: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  transform: rotate(45deg);
  transition:
  transform 0.18s ease,
  margin-top 0.18s ease;
}

.chevron--up {
  margin-top: 4px;
  transform: rotate(-135deg);
}

.dropdown {
  position: absolute;
  top: calc(100% + 12px);
  left: 0;
  /* 要盖住同组件内的遮罩（z-index 40） */
  z-index: 61;
  min-width: 280px;
  padding: 8px 0;
  border-radius: 18px;
  background-color: #fff;
  box-shadow: 0 18px 42px rgba(23, 23, 64, 0.16);
  animation: dropdown-in 0.16s ease;
}

@keyframes dropdown-in {
  from {
    opacity: 0;
    transform: translateY(-6px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 18px 26px;
  font-size: 24px;
  color: #4a4f60;
}

.option--active {
  background-color: #f5f6ff;
  color: #4f46e5;
  font-weight: 600;
}

/* #ifdef WEB */
.option:active {
  background-color: #f5f6ff;
}

/* #endif */

.option-label {
  white-space: nowrap;
}

.option-check {
  flex-shrink: 0;
  font-size: 22px;
  color: #4f46e5;
}

.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 40;
  background-color: rgba(17, 20, 40, 0.12);
}
</style>
