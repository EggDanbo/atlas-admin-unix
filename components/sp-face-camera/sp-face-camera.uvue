<script setup lang="ts">
import type { FileStorageFileResourceModel } from '@/types/api.ts'
import { computed, nextTick, onBeforeUnmount, ref, watch } from 'vue'
import { spFaceCameraProps } from './props.ts'

import { useCamera } from './use-camera.ts'

const props = defineProps(spFaceCameraProps)
const emit = defineEmits(['change', 'update:modelValue', 'update:visible'])

const h5ContainerRef = ref()
const {
  IS_WEAPP,
  state,
  tempImagePath,
  uploadProgress,
  startCamera,
  capture,
  cancelCamera,
  retake,
  upload,
  cleanup,
} = useCamera(h5ContainerRef)

const isIdle = computed(() => state.value === 'idle')
const isCamera = computed(() => state.value === 'camera')
const isPreview = computed(() => state.value === 'preview')
const isUploading = computed(() => state.value === 'uploading')

function handleClose() {
  emit('update:visible', false)
  cleanup()
}

async function handleConfirm() {
  const result = await upload()
  if (result) {
    emit('update:modelValue', result)
    emit('change', result)
    if (props.popup)
      handleClose()
    else
      cleanup()
  }
  else {
    state.value = 'preview'
  }
}

watch(() => props.visible, (val) => {
  if (val)
    nextTick(() => startCamera())
  if (!val)
    cleanup()
})

onBeforeUnmount(() => {
  cleanup()
})

// 页面自带的采集入口需要主动拉起相机，空态由页面渲染
defineExpose({ startCamera, retake, state })

</script>

<template>
  <view :class="['container', (!showIdle && isIdle ? 'container--bare' : '')]">
    <!-- idle：无照片 -->
    <view v-if="isIdle && !modelValue && showIdle" class="idleView" @click="startCamera">
      <view class="placeholderCircle">
        <text class="placeholderIcon">
          📷
        </text>
      </view>
      <text class="actionText">
        拍摄人脸照片
      </text>
    </view>

    <!-- idle：已有照片 -->
    <view v-if="isIdle && modelValue && showIdle" class="idleView">
      <view class="existingPhotoWrap">
        <image class="existingPhoto" :src="modelValue.url" mode="aspectFill" />
        <view v-if="!disabled" class="retakeOverlay" @click="startCamera">
          <text class="retakeText">
            重新拍摄
          </text>
        </view>
        <view v-if="disabled" class="lockedOverlay">
          <text class="lockedText">
            照片已锁定
          </text>
        </view>
      </view>
    </view>

    <!-- camera：fixed 全屏覆盖 -->
    <view v-if="isCamera" class="cameraContainer">
      <view class="cameraView">
        <camera
          v-if="IS_WEAPP"
          device-position="front"
          flash="auto"
          class="cameraInner"
        />
        <view v-else ref="h5ContainerRef" class="cameraInner" />
        <view class="overlay">
          <view class="frameCircle" />
        </view>
      </view>
      <text class="hintText">
        请将面部对准框内
      </text>
      <view class="cameraActions">
        <view class="cancelBtn" @click="cancelCamera">
          取消
        </view>
        <view class="captureBtn" @click="capture" />
        <view class="cancelBtn" />
      </view>
    </view>

    <!-- preview -->
    <view v-if="isPreview" class="previewContainer">
      <view class="previewHead">
        <text class="previewTitle">
          确认人脸照片
        </text>
        <text class="previewHint">
          确保面部清晰、无遮挡，照片将用于考勤识别
        </text>
      </view>
      <view class="previewImageWrap">
        <image class="previewImage" :src="tempImagePath" mode="aspectFill" />
        <view class="previewCircleBorder" />
      </view>
      <view class="previewActions">
        <view class="previewBtnGhost" @click="retake">
          重新拍摄
        </view>
        <view class="previewBtnPrimary" @click="handleConfirm">
          确认上传
        </view>
      </view>
    </view>

    <!-- uploading -->
    <view v-if="isUploading" class="uploadingView">
      <view class="uploadingRing" />
      <text class="uploadingText">
        正在上传人脸照片
      </text>
      <text class="uploadingHint">
        {{ uploadProgress }}%
      </text>
      <view class="uploadingTrack">
        <view class="uploadingBar" :style="{ width: `${uploadProgress}%` }" />
      </view>
    </view>
  </view>
</template>

<style lang="scss">
