<script setup lang="ts">
import { computed } from 'vue'
import { showToast } from '@/components/sp-toast/toast.ts'
import { useAuthStore } from '@/store/auth'
import { colors } from '@/styles/theme'
import { buildQuery, getCurrentPageInfo, routes, stripBasename } from '@/utils/router'

const demoMenus = [
  { glyph: '📄', label: '我的申请', color: colors.blue },
  { glyph: '✅', label: '我的审批', color: colors.blue },
  { glyph: '🔔', label: '我的消息', color: colors.blue },
]

function handleMenuTap() {
  showToast('请先登录')
}

const greeting = computed(() => {
  const hour = new Date().getHours()
  if (hour < 6)
    return '夜深了'
  if (hour < 9)
    return '早上好'
  if (hour < 12)
    return '上午好'
  if (hour < 14)
    return '中午好'
  if (hour < 18)
    return '下午好'
  return '晚上好'
})

const stats = computed(() => [
  { value: 0, label: '申请' },
  { value: 0, label: '待办' },
  { value: 0, label: '已办' },
])

const authStore = useAuthStore()

function handleLogin() {
  const { path, params } = getCurrentPageInfo()
  const pagePath = stripBasename(path)

  // 排除 OAuth 内部参数，仅保留业务参数
  const businessParams: Record<string, string> = {}
  const keys = Object.keys(params)
  for (let i = 0; i < keys.length; i++) {
    const k = keys[i]
    if (k === 'code' || k === 'state' || k === 'path')
      continue
    businessParams[k] = params[k]
  }
  const queryString = buildQuery(businessParams)
  const fullPath = queryString ? `${pagePath}?${queryString}` : pagePath
  authStore.saveLoginRedirect(fullPath)
  uni.navigateTo({ url: routes.login })
}

</script>

<template>
  <view>
    <!-- 仿用户卡片（点击登录） -->
    <view class="demo-card">
      <view class="demo-card-bg" style="border-radius: 10px;">
        <view class="demo-deco demo-deco--1" />
        <view class="demo-deco demo-deco--2" />

        <view class="demo-card-content" @click="handleLogin">
          <view class="demo-avatar">
            <text class="demo-avatar-glyph">
              👤
            </text>
          </view>
          <view class="demo-card-info">
            <text class="demo-card-greeting">
              {{ greeting }}，
            </text>
            <view class="demo-card-name-wrap">
              <text class="demo-card-name">
                点击登录
              </text>
              <text class="demo-card-arrow">
                ›
              </text>
            </view>
          </view>
        </view>

        <view class="user-card-stats">
          <view
            v-for="(item, idx) in stats"
            :key="item.label"
            class="stat-item"
          >
            <text class="stat-value">
              {{ item.value }}
            </text>
            <text class="stat-label">
              {{ item.label }}
            </text>
            <view v-if="Number(idx) < stats.length - 1" class="stat-item-divider" />
          </view>
        </view>
      </view>
    </view>

    <!-- 仿菜单网格 -->
    <view class="demo-menu">
      <view class="demo-menu-grid">
        <view
          v-for="item in demoMenus"
          :key="item.label"
          class="demo-menu-item"
          @click="handleMenuTap()"
        >
          <text class="demo-menu-glyph">
            {{ item.glyph }}
          </text>
          <text class="demo-menu-label">
            {{ item.label }}
          </text>
        </view>
      </view>
    </view>
  </view>
</template>

