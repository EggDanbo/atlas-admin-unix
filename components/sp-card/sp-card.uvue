<script setup lang="ts">
import { computed, getCurrentInstance } from 'vue'

const props = defineProps({
  title: { type: String, default: '' },
  hint: { type: String, default: '' },
  variant: { type: String, default: 'form' },
})

const instance = getCurrentInstance()
const slots = computed(() => instance?.slots ?? {})
const hasHead = computed(() => !!(props.title || props.hint || slots.value.title || slots.value.extra))

</script>

<template>
  <view :class="['card', `card--${variant}`]">
    <view v-if="hasHead" class="head">
      <text v-if="title || slots.title" data-role="card-title" class="title">
        <slot name="title">
          {{ title }}
        </slot>
      </text>
      <slot name="extra">
        <text v-if="hint" class="hint">
          {{ hint }}
        </text>
      </slot>
    </view>
    <slot />
  </view>
</template>

<style lang="scss">
.card {
  margin: 18rpx 18rpx 0;
  border-radius: 21rpx;
  background-color: #fff;
  box-shadow: 0 9rpx 28rpx rgba(23, 23, 64, 0.05);
}

/* 表单卡：内部是「标签 + 输入」行 */
.card--form {
  padding: 5rpx 23rpx;
}

/* 详情卡：内部是「标签 + 值」行，标题下留白更宽松 */
.card--detail {
  padding: 23rpx 28rpx 7rpx;
}

.head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  gap: 14rpx;
}

/* #ifdef WEB */
.card--form .head {
  padding: 23rpx 5rpx 5rpx;
}

/* #endif */

/* #ifdef WEB */
.card--detail .head {
  padding-bottom: 7rpx;
}

/* #endif */

.title {
  flex-shrink: 0;
  font-size: 31rpx;
  font-weight: 700;
  color: #1c1c2e;
}

.hint {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 21rpx;
  color: #a8aec0;
}

/* #ifdef WEB */
.card--detail .hint {
  font-size: 23rpx;
  color: #9aa0b4;
}

/* #endif */
</style>
