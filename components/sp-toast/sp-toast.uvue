<script setup lang="ts">
import { ref } from 'vue'

import { toastState } from './toast.ts'

// 页面栈里会有多个实例，只让当前显示的页面弹提示
const pageActive = ref(true)
onPageShow(() => {
  pageActive.value = true
})
onPageHide(() => {
  pageActive.value = false
})

const ICON: Record<string, string> = {
  success: '✓',
  error: '!',
  info: 'i',
}

</script>

<template>
  <view v-if="toastState.visible && pageActive" class="host">
    <view class="toast">
      <view :class="['icon', `icon--${toastState.type}`]">
        <text class="icon-text">
          {{ ICON[toastState.type] }}
        </text>
      </view>
      <text class="text">
        {{ toastState.title }}
      </text>
    </view>
  </view>
</template>

<style lang="scss">
.host {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9999;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
  pointer-events: none;
}

.toast {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 18rpx;
  max-width: 560rpx;
  padding: 22rpx 30rpx;
  border: 1rpx solid rgba(23, 23, 64, 0.06);
  border-radius: 24rpx;
  background-color: #fff;
  box-shadow: 0 18rpx 44rpx rgba(23, 23, 64, 0.16);
  animation: toast-in 0.22s ease-out;
}

@keyframes toast-in {
  from {
    opacity: 0;
    transform: translateY(10rpx) scale(0.96);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.icon {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
}

.icon--success {
  background-color: #ecfdf5;
  color: #0d9488;
}

.icon--error {
  background-color: #fef2f2;
  color: #dc2626;
}

.icon--info {
  background-color: #eef2ff;
