<script setup lang="ts">
import { ref, watch } from 'vue'

const props = defineProps({
  modelValue: { type: String, default: '' },
  placeholder: { type: String, default: '搜索' },
  confirmType: { type: String, default: 'search' },
  clearable: { type: Boolean, default: true },
  inset: { type: Boolean, default: true },
})

const emit = defineEmits(['clear', 'confirm', 'update:modelValue'])

// 本地镜像：confirm 要拿到「刚输入完」的值，等父级 props 回流会滞后一拍
const inner = ref(props.modelValue)

watch(() => props.modelValue, (value) => {
  if (value !== inner.value)
    inner.value = value ?? ''
})

function handleInput(e: any) {
  inner.value = e?.detail?.value ?? ''
  emit('update:modelValue', inner.value)
}

function handleConfirm() {
  emit('confirm', inner.value)
}

function handleClear() {
  inner.value = ''
  emit('update:modelValue', '')
  emit('clear')
}

</script>

<template>
  <view :class="['search', (inset ? 'search--inset' : '')]">
    <view class="search-icon" />
    <input
      :value="inner"
      class="search-input"
      :placeholder="placeholder"
      :placeholder-class="'search-placeholder'"
      :confirm-type="confirmType"
      @input="handleInput"
      @confirm="handleConfirm" />
    <view
      v-if="clearable && inner"
      class="search-clear"
      @click="handleClear"
    >
      <text class="search-clear-icon">
        ×
      </text>
    </view>
  </view>
</template>

<style lang="scss">
.search {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  height: 87rpx;
  padding: 0 25rpx;
  border-radius: 21rpx;
  border: 1.2rpx solid #edeff6;
  background-color: #fff;
  box-shadow: 0 7rpx 21rpx rgba(23, 23, 64, 0.04);
}

/* 页面顶层使用时自带左右留白；放进工具栏时由父级控制 */
.search--inset {
  margin: 18rpx 18rpx 0;
}

.search-icon {
  position: relative;
  flex-shrink: 0;
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #b6bccd;
  border-radius: 50%;
}

/* #ifdef WEB */
.search-icon::after {
  content: '';
  position: absolute;
  right: -7rpx;
  bottom: -2rpx;
  width: 12rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background-color: #b6bccd;
  transform: rotate(45deg);
}

/* #endif */

.search-input {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 100%;
  font-size: 28rpx;
  color: #23263a;
}

.search-placeholder {
  color: #b3b8c8;
}

.search-clear {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 37rpx;
  height: 37rpx;
  border-radius: 50%;
  background-color: #eef0f6;
}

/* #ifdef WEB */
.search-clear:active {
  background-color: #e4e7f2;
}

/* #endif */

.search-clear-icon {
  font-size: 28rpx;
  line-height: 1;
  color: #8a90a3;
}
</style>
