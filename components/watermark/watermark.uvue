<script setup lang="ts">
import { computed } from 'vue'
import { useAuthStore } from '@/store/auth'

const authStore = useAuthStore()

const watermarkText = computed(() => {
  const name = authStore.userInfo?.name || ''
  const mobile = authStore.userInfo?.mobile_number || ''
  const tail = mobile.length >= 4 ? mobile.slice(-4) : ''
  if (name && tail)
    return `${name} ${tail}`
  if (name)
    return name
  return '未登录'
})

</script>

<template>
  <view class="watermark">
    <view v-for="row in 12" :key="row" class="watermark-row">
      <view v-for="col in 4" :key="col" class="watermark-item">
        {{ watermarkText }}
      </view>
    </view>
  </view>
</template>

<style lang="scss">
.watermark {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 9999;
  overflow: hidden;
}

.watermark-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 120rpx;
  transform: rotate(-30deg);
  transform-origin: center center;
}

.watermark-item {
  flex-shrink: 0;
  color: rgba(0, 0, 0, 0.035);
  font-size: 16rpx;
  white-space: nowrap;
  padding: 0 40rpx;
}
</style>
