<script setup lang="ts">
defineProps({
  label: { type: String, default: '' },
  required: { type: Boolean, default: false },
  error: { type: String, default: '' },
  success: { type: String, default: '' },
  arrow: { type: Boolean, default: false },
})

</script>

<template>
  <view class="item">
    <view :class="['row', error && 'row--error']">
      <text v-if="label" class="label">
        {{ label }}<text v-if="required" class="req">
          *
        </text>
      </text>

      <slot />

      <view v-if="arrow" class="arrow" />
    </view>

    <view v-if="error" data-role="form-error" class="error">
      {{ error }}
    </view>
    <view v-else-if="success" class="success">
      {{ success }}
    </view>
  </view>
</template>

<style lang="scss">
