/* 带固定底部操作栏的页面：为底栏预留高度 */
.sp-page--with-bar {
  /* 页面自身的 `.page { padding: 0 32rpx }` 是简写、同特异性，会把这里重置掉，
     必须 !important（uni-app x 仅允许在类选择器里用 !important），否则内容被底栏盖住。 */
  padding-bottom: 250rpx !important;
}

/* 带悬浮按钮（FAB）的页面：右下角按钮 + 间距预留 */
.sp-page--with-fab {
  /* 同上：避让右下角悬浮按钮 */
  padding-bottom: 200rpx !important;
}

.sp-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
}

/* 回到顶部按钮 */
.sp-backtop {
  position: fixed;
  right: 20rpx;
  bottom: 140rpx;
  z-index: 100;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  font-size: 28rpx;
  color: #4f46e5;
  background-color: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(45, 140, 240, 0.2);
  border-radius: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
