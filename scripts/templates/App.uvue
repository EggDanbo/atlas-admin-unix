<script lang="ts">
/**
 * 应用入口
 *
 * 与 Taro 版的差异：
 * - createApp(App) → createSSRApp(App)，由 main.uts 承担
 * - 不再需要 pinia 挂载（状态用 store/*.uts 里的全局 reactive 变量）
 * - AbortController polyfill 移除（请求层改用 uni.request）
 */
import { registerTokenExpiredHandler } from '@/api/http/index.ts'
import { checkAppUpdate } from '@/composables/use-update-checker.ts'
import { useAppInfoStore } from '@/store/appinfo.ts'
import { useAppStore } from '@/store/app.ts'
import { useAuthStore } from '@/store/auth.ts'
import { useEnumStoreWithOut } from '@/store/enums.ts'
import { storage } from '@/utils/storage.ts'
import { watch } from 'vue'

export default {
  onLaunch() {
    const appStore = useAppStore()
    appStore.initSystemInfo()

    const appInfoStore = useAppInfoStore()
    void appInfoStore.asyncAppInfo()

    const authStore = useAuthStore()
    const enumStore = useEnumStoreWithOut()

    // 请求层捕获到 token 失效时，把登录态降级（避免与 store 循环依赖）
    registerTokenExpiredHandler(() => {
      authStore.downgrade()
      enumStore.resetStore()
    })

    // 认证初始化（异步，不阻塞首屏）
    void authStore.init()

    // 枚举随认证状态加载
    watch(() => authStore.status, (status: string) => {
      if (status === 'auth') {
        void enumStore.ensureLoaded()
        // 登录成功即解除首页守卫的防回环冷却
        storage.remove('login_guard_at')
      }
      else if (status === 'guest') {
        enumStore.resetStore()
      }
    }, { immediate: true })

  },

  onShow() {
    // 小程序更新检查
    checkAppUpdate()
  },
}
</script>

<style lang="scss">
/* ============================================================
 * 全局样式
 *
 * uni-app x 的 App.uvue 样式对所有页面生效；组件样式默认隔离。
 * 注意：ucss 只支持 class 选择器，且样式不继承（文本样式必须写在 text 上）。
 * ============================================================ */

/* ---------- 页面布局 ---------- */

.sp-page {
  min-height: 100vh;
  background-color: #f5f6fa;
  box-sizing: border-box;
