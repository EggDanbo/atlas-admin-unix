  color: #c2c6d4;
}

/* ============================================================
 * 还原 view / text 的默认行为（仅针对我们自己的元素）
 *
 * uni-app x 重置了 CSS：view 默认 flex + column、text 默认 block + 左对齐，
 * 与 Taro/H5 的 block / inline 语义不同，会导致「本该并排的元素竖排、
 * 容器上的 text-align: center 不生效」。
 *
 * 两个限定缺一不可：
 * 1. :not([class*="uni-"]) —— 排除 uni 内置组件（modal / toast / picker）的内部结构，
 *    它们的布局就是按重置后的默认值写的，改了会错乱；
 * 2. :where(...) —— 把特异性归零，只与框架重置（0,0,2）打平靠后生效，
 *    不会盖过 .sp-btn / .row 这类类选择器（否则 flex 会被改成 block）。
 * ============================================================ */

/* #ifdef WEB */
uni-app uni-view:where(:not([class*="uni-"])) {
  display: block;
  /* 框架给所有 view 加了 overflow: hidden，会把绝对定位的下拉面板整个裁掉 */
  overflow: visible;
}

uni-app uni-text:where(:not([class*="uni-"])) {
  display: inline;
  text-align: inherit;
}
/* #endif */

/* #ifdef MP-WEIXIN || MP-ALIPAY || MP-BAIDU || MP-TOUTIAO */
page view {
  display: block;
  overflow: visible;
}

page text {
  display: inline;
  text-align: inherit;
}
/* #endif */
</style>
